@Tutorial(time: 10) {
    @Intro(title: "Adding Syntax Highlighting") {
        Enable beautiful syntax highlighting for 20 programming languages in your code editor with just a few lines of code.
        
        @Image(source: syntax-highlighting-intro.png, alt: "Syntax highlighted code examples")
    }
    
    @Section(title: "Setting the Language") {
        @ContentAndMedia {
            CodeEditorPlugin can automatically detect languages from file extensions or you can set them manually.
            
            @Image(source: language-detection.png, alt: "Language detection in action")
        }
        
        @Steps {
            @Step {
                Set the language using the codeLanguage modifier.
                
                @Code(name: "ContentView.swift", file: syntax-01-basic.swift)
            }
            
            @Step {
                Detect language from file extension.
                
                @Code(name: "ContentView.swift", file: syntax-02-detection.swift)
            }
            
            @Step {
                Change language dynamically.
                
                @Code(name: "ContentView.swift", file: syntax-03-dynamic.swift)
            }
        }
    }
    
    @Section(title: "Customizing Highlighting") {
        @ContentAndMedia {
            Fine-tune the highlighting experience with themes and performance settings.
            
            @Image(source: syntax-customization.png, alt: "Theme customization")
        }
        
        @Steps {
            @Step {
                Apply a dark theme for better contrast.
                
                @Code(name: "ContentView.swift", file: syntax-04-theme.swift)
            }
            
            @Step {
                Optimize for large files.
                
                @Code(name: "ContentView.swift", file: syntax-05-performance.swift)
            }
        }
    }
}