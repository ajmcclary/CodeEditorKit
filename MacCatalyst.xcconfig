// Mac Catalyst Build Configuration
// Helps resolve build issues with Xcode beta and Mac Catalyst

// Suppress search path warnings
OTHER_LDFLAGS = $(inherited) -Xlinker -w

// Explicitly set Mac Catalyst deployment target
IPHONEOS_DEPLOYMENT_TARGET = 16.0
SUPPORTS_MACCATALYST = YES

// Framework search paths - remove problematic beta paths
FRAMEWORK_SEARCH_PATHS = $(inherited) $(PLATFORM_DIR)/Developer/Library/Frameworks

// Library search paths - filter out missing paths
LIBRARY_SEARCH_PATHS = $(inherited)

// Module map paths
SWIFT_INCLUDE_PATHS = $(inherited) $(SRCROOT)

// Disable bitcode for Mac Catalyst
ENABLE_BITCODE = NO

// Ensure proper Swift version
SWIFT_VERSION = 5.0

// Silence specific warnings
WARNING_CFLAGS = $(inherited) -Wno-shorten-64-to-32