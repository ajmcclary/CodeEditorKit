# SwiftFormat configuration
# Matches SwiftLint .swiftlint.yml settings

# Indentation
--indent 4
--indentcase false
--smarttabs enabled
--tabwidth 4
--xcodeindentation enabled

# Spacing
--commas inline
--semicolons inline
--trimwhitespace always
--indent 4
--tabwidth 4
--smarttabs enabled

# Wrapping
--wraparguments preserve
--wrapparameters preserve
--wrapcollections preserve
--wrapconditions preserve
--wrapternary default

# Organization
--importgrouping alpha
--extensionacl on-declarations

# Rules to enable (matching SwiftLint opt-in rules)
--enable isEmpty
--enable sortImports
--enable strongifiedSelf
--enable trailingCommas
--enable unusedArguments
--enable void
--enable wrap
--enable wrapMultilineStatementBraces

# Rules to disable (matching SwiftLint disabled rules)
--disable linebreakAtEndOfFile
--disable organizeDeclarations
--disable redundantFileprivate
--disable redundantSelf
--disable strongOutlets
--disable todos
--disable typeSugar

# File types
--exclude .build
--exclude **/*.generated.swift

# Swift version
--swiftversion 6.0

# Match SwiftLint indentation expectations
--ifdef no-indent
--indentstrings false